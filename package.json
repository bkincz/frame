{
  "name": "@bkincz/frame",
  "version": "2.0.0",
  "description": "A production-ready, TypeScript-first React multi-step flow system with animations, navigation history, and customizable layouts",
  "type": "module",
  "main": "./dist/frame.cjs",
  "module": "./dist/frame.mjs",
  "types": "./dist/frame.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/frame.d.mts",
        "default": "./dist/frame.mjs"
      },
      "require": {
        "types": "./dist/frame.d.cts",
        "default": "./dist/frame.cjs"
      }
    },
    "./styles": "./dist/frame.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "keywords": [
    "react",
    "components",
    "flow",
    "wizard",
    "multi-step",
    "stepper",
    "forms",
    "ui",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/bkincz/frame.git"
  },
  "bugs": {
    "url": "https://github.com/bkincz/frame/issues"
  },
  "homepage": "https://github.com/bkincz/frame#readme",
  "author": "Benjamin Kinczel <beni.kinczel@gmail.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:lib": "vite build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run verify",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build:lib",
    "test:run": "vitest run"
  },
  "peerDependencies": {
    "@bkincz/clutch": "^3.5.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@bkincz/clutch": "^3.5.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.6.0"
}
